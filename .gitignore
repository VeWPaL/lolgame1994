# The game is a shell that loads plain <script> files, and the C# port lives beside it. Both
# must never be ignored, and neither must ever have its line endings rewritten: every file here is
# LF-only by design, and a CRLF pass would break the byte-level encoding the middle-dot canary
# depends on. core.autocrlf is off in this repo for the same reason.
*
!.gitignore
!CONVENTIONS.md
!depths.html
!src/
src/*
!src/*.js

# the C# port. Source is tracked, build output is not.
!csharp/
csharp/*
!csharp/*.sln
csharp/Depths.Core/
!csharp/Depths.Core/
csharp/Depths.Core/*
!csharp/Depths.Core/*.cs
!csharp/Depths.Core/*.csproj
csharp/Depths.Tests/
!csharp/Depths.Tests/
csharp/Depths.Tests/*
!csharp/Depths.Tests/*.cs
!csharp/Depths.Tests/*.csproj

bin/
obj/
*.user
.vs/
.idea/
!verify.ps1

# Session reports. The whitelist is by exception, so a new doc needs naming here or it is invisible
# to git - which is exactly what happened to REPORT.md, written and then silently not committed.
!REPORT.md
