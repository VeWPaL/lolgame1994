# The game is a shell that loads ten plain <script> files. They must never be ignored, and
# they must never have their line endings rewritten: every file here is LF-only by design, and a
# CRLF pass would break the byte-level encoding the middle-dot canary depends on. core.autocrlf
# is off in this repo for the same reason.
*
!.gitignore
!depths.html
!src/
src/*
!src/*.js

# the C# port. Source is tracked, build output is not.
!csharp/
csharp/*
!csharp/*.sln
csharp/Depths.Core/
!csharp/Depths.Core/
csharp/Depths.Core/*
!csharp/Depths.Core/*.cs
!csharp/Depths.Core/*.csproj
csharp/Depths.Tests/
!csharp/Depths.Tests/
csharp/Depths.Tests/*
!csharp/Depths.Tests/*.cs
!csharp/Depths.Tests/*.csproj

bin/
obj/
*.user
.vs/
.idea/
