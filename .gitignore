# The game is a shell that loads ten plain <script> files. They must never be ignored, and
# they must never have their line endings rewritten: every file here is LF-only by design, and a
# CRLF pass would break the byte-level encoding the middle-dot canary depends on. core.autocrlf
# is off in this repo for the same reason.
*
!.gitignore
!depths.html
!src/
src/*
!src/*.js

# scratch and build output
bin/
obj/
*.user
.vs/
.idea/
