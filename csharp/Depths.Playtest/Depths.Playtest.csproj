<Project Sdk="Microsoft.NET.Sdk">

  <!-- The playtest bot: plays whole runs on Depths.Core and writes playtest/<label>.json.
       net9.0 like Depths.Tests; it is a tool, not part of the Unity package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>Depths.Playtest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Depths.Core\Depths.Core.csproj" />
  </ItemGroup>

</Project>
