<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="root" class="root desk">
        <ui:VisualElement name="book" class="book">
            <ui:VisualElement name="main" class="spread">
                <ui:VisualElement class="page left">
                    <ui:VisualElement name="titleStamp" class="title-stamp" />
                    <ui:VisualElement name="portrait" class="portrait" />
                </ui:VisualElement>
                <ui:VisualElement class="page right">
                    <ui:Label text="Contents" class="page-head italic" />
                    <ui:Button name="start" class="entry">
                        <ui:Label text="I" class="entry-num" />
                        <ui:Label text="Start Game" class="entry-text" />
                    </ui:Button>
                    <ui:Button name="options" class="entry">
                        <ui:Label text="II" class="entry-num" />
                        <ui:Label text="Options" class="entry-text" />
                    </ui:Button>
                    <ui:Button name="quit" class="entry">
                        <ui:Label text="III" class="entry-num" />
                        <ui:Label text="Quit" class="entry-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="optionsPanel" class="spread hidden">
                <ui:VisualElement class="page left">
                    <ui:Label text="Options" class="page-head italic" />
                    <ui:VisualElement class="tabs">
                        <ui:Button name="tabControls" class="entry tab">
                            <ui:Label text="I" class="entry-num" />
                            <ui:Label text="Controls" class="entry-text" />
                        </ui:Button>
                        <ui:Button name="tabAudio" class="entry tab">
                            <ui:Label text="II" class="entry-num" />
                            <ui:Label text="Audio" class="entry-text" />
                        </ui:Button>
                        <ui:Button name="tabGameplay" class="entry tab">
                            <ui:Label text="III" class="entry-num" />
                            <ui:Label text="Gameplay" class="entry-text" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Button name="back" class="entry back">
                        <ui:Label text="&lt;" class="entry-num" />
                        <ui:Label text="Back to the contents" class="entry-text" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="page right">
                    <ui:Label name="pageTitle" text="Controls" class="page-head italic" />
                    <ui:VisualElement name="controlsPage" class="opt-page">
                        <ui:DropdownField name="preset" label="Keyboard layout" class="ledger-dropdown" />
                        <ui:ScrollView name="bindList" class="bind-list" />
                        <ui:Button name="resetBinds" text="Reset to layout" class="small-btn" />
                    </ui:VisualElement>
                    <ui:VisualElement name="audioPage" class="opt-page hidden">
                        <ui:Slider name="vol-Master" label="Master" low-value="0" high-value="1" show-input-field="false" class="ledger-slider" />
                        <ui:Slider name="vol-Music" label="Music" low-value="0" high-value="1" class="ledger-slider" />
                        <ui:Slider name="vol-Sfx" label="Sound effects" low-value="0" high-value="1" class="ledger-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement name="gameplayPage" class="opt-page hidden">
                        <ui:DropdownField name="shake" label="Screen shake" class="ledger-dropdown" />
                        <ui:DropdownField name="frameRate" label="Frame rate" class="ledger-dropdown" />
                        <ui:TextField name="customFps" label="Your cap (fps)" max-length="3" is-delayed="true" class="ledger-dropdown ledger-text hidden" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
