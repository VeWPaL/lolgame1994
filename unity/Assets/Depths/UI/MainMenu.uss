/* The menu is an open ledger on a desk: ink on aged paper, wood around it. Textures (desk, book,
   key caps, knob, tick box, the title) are baked at runtime by MainMenuController from the HUD's
   materials; this sheet only places things and inks them. Ink rgb(43,29,18), soft ink rgb(90,70,48),
   red ink rgb(163,40,31), the ruled blue rgba(64,96,140,0.3). */
.root { flex-grow: 1; align-items: center; justify-content: center; background-color: rgb(11, 13, 18); }
.hidden { display: none; }

.book { position: absolute; width: 1100px; height: 646px; left: 90px; top: 34px; }
.spread { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.page { position: absolute; top: 22px; width: 528px; height: 576px; padding-left: 72px; padding-right: 40px; }
.page.left { left: 22px; }
.page.right { left: 550px; }
.page-head { height: 96px; margin: 0; padding: 0 0 10px 0; font-size: 32px; color: rgb(43, 29, 18); -unity-text-align: lower-left; }

/* the left page of the contents */
.title-stamp { align-self: center; margin-top: 30px; margin-left: -72px; margin-right: -40px; }
.portrait { align-self: center; margin-top: 110px; margin-left: -32px; }

/* an entry: a written line with its number in the margin; the ribbon marks the one you are on */
.entry { flex-direction: row; align-items: center; height: 54px; margin: 0; padding: 0 10px 0 10px;
         background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; border-bottom-width: 1px;
         border-color: rgba(64, 96, 140, 0.3); -unity-text-align: middle-left; }
.entry:hover, .entry:focus, .entry:active { background-color: rgba(163, 40, 31, 0.07); }
.entry:focus { border-left-width: 7px; border-left-color: rgb(140, 42, 42); border-bottom-color: rgb(163, 40, 31); }
.entry-num { position: absolute; left: -66px; width: 48px; font-size: 18px; color: rgb(90, 70, 48); -unity-text-align: middle-right; margin: 0; padding: 0; }
.entry-text { font-size: 25px; color: rgb(43, 29, 18); margin: 0; padding: 0; }
.entry:hover .entry-text, .entry:focus .entry-text { color: rgb(163, 40, 31); }
.entry:hover .entry-num, .entry:focus .entry-num { color: rgb(163, 40, 31); }
/* the open section is marked differently from keyboard focus: an underline and a bookmark tab on the
   right; focus is the ribbon on the left. A focused open section shows both. */
.tab.selected { border-bottom-width: 3px; border-bottom-color: rgb(140, 42, 42); border-right-width: 10px; border-right-color: rgb(140, 42, 42); }
.tab.selected .entry-text { color: rgb(140, 42, 42); }
.tab.selected .entry-num { color: rgb(140, 42, 42); }
.back { position: absolute; left: 72px; right: 40px; bottom: 26px; border-top-width: 1px; }
.back .entry-text { font-size: 20px; }

/* the options pages */
.opt-page { flex-grow: 1; padding-top: 14px; }
.opt-page .ledger-dropdown { margin-bottom: 14px; }
Label, .unity-base-field__label { color: rgb(43, 29, 18); }
.unity-base-field__label { font-size: 17px; min-width: 150px; }

.ledger-dropdown { margin: 0; height: 34px; align-items: center; }
/* the field: a wooden frame around a paper slip, baked and 9-sliced by the controller; a brass arrow */
.ledger-dropdown .unity-base-popup-field__input, .ledger-dropdown .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; color: rgb(43, 29, 18); padding: 0 10px 0 12px; height: 32px; }
.ledger-dropdown:hover .unity-base-field__input, .ledger-dropdown:focus .unity-base-field__input { -unity-background-image-tint-color: rgb(255, 226, 200); }
.unity-base-popup-field__text { color: rgb(43, 29, 18); font-size: 15px; -unity-text-align: middle-left; padding: 0; margin: 0; }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(255, 255, 255); }
.ledger-text .unity-base-text-field__input { max-width: 90px; font-size: 15px; -unity-text-align: middle-left; }

.bind-list { max-height: 330px; margin-top: 2px; }
.bind-row { flex-direction: row; align-items: center; justify-content: space-between; height: 34px;
            border-bottom-width: 1px; border-color: rgba(64, 96, 140, 0.3); }
.bind-name { color: rgb(43, 29, 18); font-size: 16px; }
.bind-key { width: 132px; height: 30px; margin: 0; padding: 0 0 4px 0; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0;
            color: rgb(240, 226, 196); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; }
.bind-key:hover, .bind-key:focus { background-color: rgba(0, 0, 0, 0); color: rgb(255, 238, 190); border-width: 2px; border-color: rgb(224, 192, 122); }
.bind-key.listening { color: rgb(255, 214, 120); border-width: 2px; border-color: rgb(255, 214, 120); }

.small-btn { align-self: flex-end; height: 28px; margin-top: 8px; padding: 0 6px; background-color: rgba(0, 0, 0, 0); border-width: 0;
             border-radius: 0; color: rgb(163, 40, 31); font-size: 15px; -unity-text-align: middle-right; }
.small-btn:hover, .small-btn:focus { background-color: rgba(163, 40, 31, 0.08); border-bottom-width: 2px; border-color: rgb(163, 40, 31); }

.ledger-slider { margin: 16px 0 10px 0; height: 34px; }
.ledger-slider .unity-base-slider__input { margin-right: 6px; }
.ledger-slider .unity-base-slider__tracker { height: 14px; margin-top: -7px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; }
.ledger-slider .unity-base-slider__dragger { width: 16px; height: 26px; margin-top: -12px; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.ledger-slider .unity-base-slider__dragger-border { display: none; }
.ledger-slider:focus .unity-base-slider__tracker, .ledger-slider:hover .unity-base-slider__tracker { -unity-background-image-tint-color: rgb(255, 222, 196); }
.ledger-slider:focus .unity-base-field__label, .ledger-slider:hover .unity-base-field__label { color: rgb(163, 40, 31); }

.unity-scroller { background-color: rgba(43, 29, 18, 0.08); border-width: 0; }
.unity-scroller .unity-base-slider__dragger { background-color: rgba(43, 29, 18, 0.5); border-width: 0; }
.unity-scroller .unity-repeat-button { background-color: rgba(0, 0, 0, 0); border-width: 0; }
