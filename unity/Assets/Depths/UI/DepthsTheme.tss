@import url("unity-theme://default");

/* The dropdown's list opens on the panel's root, outside the menu's own sheet, so its ledger
   styling lives here: a slip of paper with a wooden edge, ink entries, a red-ink pick. */
.unity-base-dropdown__container-outer { background-color: rgb(226, 214, 186); border-width: 2px; border-color: rgb(58, 34, 16); border-radius: 2px; }
.unity-base-dropdown__container-inner { background-color: rgb(226, 214, 186); }
.unity-base-dropdown__item { color: rgb(43, 29, 18); background-color: rgba(0, 0, 0, 0); }
.unity-base-dropdown__item:hover { background-color: rgba(163, 40, 31, 0.14); }
.unity-base-dropdown__item:checked, .unity-base-dropdown__item.unity-base-dropdown__item--checked { color: rgb(163, 40, 31); }
.unity-base-dropdown__label { color: rgb(43, 29, 18); }
.unity-base-dropdown__checkmark { -unity-background-image-tint-color: rgb(163, 40, 31); }
.unity-base-dropdown .unity-scroller { background-color: rgba(43, 29, 18, 0.08); }
